# Copy this file to backend/.env. Do not commit backend/.env.
#
# Native PostgreSQL defaults to port 5432. If you use Docker Compose instead,
# change both URLs below to port 5433.
APP_NAME=AlgoProfitX
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://tradebh:replace-with-a-local-password@localhost:5432/tradeebh
TEST_DATABASE_URL=postgresql+asyncpg://tradebh:replace-with-a-local-password@localhost:5432/tradeebh_test
DATABASE_REQUIRE_TLS=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
# Set true only when DATABASE_URL points at an external transaction pooler.
DB_EXTERNAL_TRANSACTION_POOLER=false
LOG_LEVEL=INFO
# Production defaults to json when omitted; development defaults to console.
# LOG_FORMAT=json
READINESS_DB_TIMEOUT_SECONDS=2
REQUEST_ID_HEADER=X-Request-ID

# Generate a private development value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-private-local-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_JWT_ISSUER=algoprofitx-api
AUTH_JWT_AUDIENCE=algoprofitx-web
AUTH_JWT_KEY_ID=primary
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_MAX_SESSIONS_PER_USER=5
AUTH_REFRESH_COOKIE_NAME=algoprofitx_refresh
AUTH_CSRF_COOKIE_NAME=algoprofitx_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_PATH=/api/v1/auth
# AUTH_COOKIE_DOMAIN is intentionally unset for a host-only API cookie.
# The readable CSRF cookie is separate. Production subdomain deployments set
# its parent domain while the sensitive refresh cookie remains host-only.
AUTH_CSRF_COOKIE_PATH=/
# AUTH_CSRF_COOKIE_DOMAIN=algoprofitx.com

# Comma-separated browser origins allowed to call the API. Do not use '*'.
# Add a production frontend origin explicitly when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:8000
API_DOCS_ENABLED=true

# Process-local application abuse controls. Keep enabled in production.
ABUSE_PROTECTION_ENABLED=true
LOGIN_IP_LIMIT=10
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_ACCOUNT_LIMIT=20
LOGIN_ACCOUNT_WINDOW_SECONDS=900
REGISTRATION_IP_LIMIT=20
REGISTRATION_IP_WINDOW_SECONDS=3600
CREATOR_ENROLLMENT_LIMIT=3
CREATOR_ENROLLMENT_WINDOW_SECONDS=3600
BACKTEST_BURST_LIMIT=5
BACKTEST_BURST_WINDOW_SECONDS=60
BACKTEST_SUSTAINED_LIMIT=30
BACKTEST_SUSTAINED_WINDOW_SECONDS=3600
EXECUTION_BURST_LIMIT=10
EXECUTION_BURST_WINDOW_SECONDS=60
EXECUTION_SUSTAINED_LIMIT=60
EXECUTION_SUSTAINED_WINDOW_SECONDS=3600
BACKTEST_MAX_CONCURRENCY_PER_USER=1

# Production guidance (do not uncomment without replacing every value):
# APP_ENV=production
# DEBUG=false
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<managed-postgres-host>/<database>
# DATABASE_REQUIRE_TLS=true
# SECRET_KEY=<generate-a-unique-high-entropy-secret-of-at-least-32-bytes>
# CORS_ALLOWED_ORIGINS=https://www.algoprofitx.com,https://algoprofitx.com
# Production must remain disabled until a durable Catalyst worker is deployed.
# BACKTEST_EXECUTION_MODE=disabled
# Supply exactly one certificate-verifying CA transport in production.
# PGSSLROOTCERT=/run/secrets/aiven-ca.pem
# PGSSLROOTCERT_B64=<single-line-base64-encoded-Aiven-CA>
# FRONTEND_PUBLIC_URL=https://www.algoprofitx.com
# API_PUBLIC_URL=https://api.algoprofitx.com
# API_DOCS_ENABLED=false
# ABUSE_PROTECTION_ENABLED=true
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_HTTPONLY=true
# AUTH_CSRF_COOKIE_DOMAIN=algoprofitx.com
# AUTH_CSRF_COOKIE_PATH=/

# Redis is not required by the current application. Add REDIS_URL only when
# a feature actually connects to Redis.

# Historical market data is server-selected. Synthetic data requires no credentials.
MARKET_DATA_PROVIDER=synthetic
MARKET_DATA_TIMEOUT_SECONDS=15
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_MAX_RANGE_DAYS=3660
MARKET_DATA_MAX_CANDLES=4000
