# The FastAPI API prefix. This value is public browser configuration, not a secret.
# Every VITE_* value is shipped to browsers. Never place credentials or secrets here.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Built bundles are same-origin: the browser calls its own web origin and the web service proxies
# /api/v1 to the API. A build must declare its environment, and the API URL must be the one approved
# for it in frontend/environments.json (the Docker build and CI fail otherwise):
# VITE_APP_ENV=production   VITE_API_BASE_URL=https://www.algoprofitx.com/api/v1
# VITE_APP_ENV=development  VITE_API_BASE_URL=https://algoprofitx-web-50045554365.development.catalystappsail.in/api/v1
