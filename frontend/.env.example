# The FastAPI API prefix. This value is public browser configuration, not a secret.
# Every VITE_* value is shipped to browsers. Never place credentials or secrets here.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Production builds must override this with:
# VITE_API_BASE_URL=https://api.algoprofitx.com/api/v1
